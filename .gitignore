/.env
/vendor/
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess

# Sample/test output (bisa berisi data mahasiswa asli) — jangan pernah commit
/*.pdf
/*.xlsx
/*.docx

# Catatan kredensial pribadi — jangan pernah commit
DATA.GW

# Data personal asli (nama, NIP dosen) — hanya untuk seed lokal/production,
# jangan dipublikasikan di repo publik
/database/seeds/

# Backup database — berisi data mahasiswa & dosen asli, jangan pernah commit
/database/backups/*
!/database/backups/backup.sh

# Metadata tooling lokal
/.claude/
